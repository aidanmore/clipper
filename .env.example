PORT=3000
# Set to 1 only behind Railway or another trusted reverse proxy.
TRUST_PROXY=0
DATA_DIR=./data
# Choose a workspace password. Never commit the real .env file.
CLIPPER_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ASSEMBLYAI_API_KEY=
PODCAST_FEED_URL=https://anchor.fm/s/1014cea94/podcast/rss
ALLOWED_ORIGINS=https://aidanmore.github.io
SPEECH_MODEL=universal-3-5-pro
LLM_MODEL=gemini-2.5-flash
MAX_FILE_MB=600
MAX_EPISODE_HOURS=4
MAX_STORAGE_GB=4
MONTHLY_AUDIO_HOURS=10
MONTHLY_LLM_CALLS=200
